#!/usr/bin/env python3
import json
import os
import socket
import sys
import time

runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp") + "/read-aloud"
state_path = runtime + "/state.json"
socket_path = runtime + "/mpv.sock"
action = sys.argv[1] if len(sys.argv) > 1 else "status"


def read_state():
    try:
        with open(state_path, encoding="utf-8") as handle:
            data = json.load(handle)
        if isinstance(data, dict):
            return data
    except (OSError, ValueError):
        pass
    return {"status": "idle", "index": 0, "total": 0, "failed": 0, "prepared": 0, "durations": [], "speed": 1.0}


def write_state(**values):
    data = read_state()
    for key, value in values.items():
        data[key] = value
    tmp = state_path + ".tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(data, handle, ensure_ascii=False, separators=(",", ":"))
            handle.write("\n")
        os.replace(tmp, state_path)
    except OSError as error:
        print(str(error), file=sys.stderr)


def send(command):
    request_id = 1
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(1)
            client.connect(socket_path)
            payload = {"command": command, "request_id": request_id}
            client.sendall((json.dumps(payload) + "\n").encode())
            data = b""
            try:
                while b"\n" not in data:
                    chunk = client.recv(65536)
                    if not chunk:
                        break
                    data += chunk
            except socket.timeout:
                pass
    except OSError as error:
        print(str(error), file=sys.stderr)
        return {}

    for line in data.decode("utf-8", "replace").splitlines():
        try:
            reply = json.loads(line)
        except ValueError:
            continue
        if reply.get("request_id") == request_id:
            return reply
    return {}


def mpv_properties():
    if not os.path.exists(socket_path):
        return {}
    result = {}
    names = {
        "position": "time-pos",
        "chunkDuration": "duration",
        "mpvIndex": "playlist-pos",
        "paused": "pause",
        "idle": "idle-active",
        "speed": "speed",
    }
    for key, name in names.items():
        reply = send(["get_property", name])
        if "data" in reply:
            result[key] = reply["data"]
    return result


def durations_from(state):
    values = state.get("durations")
    if not isinstance(values, list):
        return []
    out = []
    for value in values:
        try:
            out.append(max(0.0, float(value)))
        except (TypeError, ValueError):
            out.append(0.0)
    return out


def is_generating(state):
    if state.get("status") != "playing":
        return False
    try:
        return int(state.get("prepared", 0)) < int(state.get("total", 0))
    except (TypeError, ValueError):
        return False


def number_or(value, fallback):
    try:
        return float(value)
    except (TypeError, ValueError):
        return fallback


def current_chunk_index(state, props=None):
    props = props if props is not None else mpv_properties()
    idx = props.get("mpvIndex")
    if isinstance(idx, int) and idx >= 0:
        return idx
    try:
        return max(0, int(state.get("index", 1)) - 1)
    except (TypeError, ValueError):
        return 0


def seek_global(target):
    state = read_state()
    durations = durations_from(state)
    if not durations:
        send(["seek", target, "absolute"])
        return
    total = sum(durations)
    target = min(max(0.0, target), max(0.0, total - 0.05))
    remaining = target
    for idx, duration in enumerate(durations):
        if duration <= 0 and idx < len(durations) - 1:
            continue
        if remaining <= duration or idx == len(durations) - 1:
            send(["set_property", "playlist-pos", idx])
            time.sleep(0.15)
            position = min(max(0.0, remaining), max(0.0, duration - 0.05))
            send(["set_property", "time-pos", position])
            break
        remaining -= duration


def seek_chunk(target):
    state = read_state()
    props = mpv_properties()
    duration = number_or(props.get("chunkDuration"), 0.0)
    if duration <= 0:
        durations = durations_from(state)
        idx = current_chunk_index(state, props)
        duration = durations[idx] if idx < len(durations) else 0.0
    position = min(max(0.0, target), max(0.0, duration - 0.05)) if duration > 0 else max(0.0, target)
    send(["set_property", "time-pos", position])


if action == "status":
    state = read_state()
    props = mpv_properties() if state.get("status") == "playing" else {}
    state.update(props)
    durations = durations_from(state)
    if durations and "position" in state:
        idx = min(current_chunk_index(state, props), len(durations) - 1)
        position = max(0.0, number_or(state.get("position"), 0.0))
        total = sum(durations)
        state["index"] = idx + 1
        state["duration"] = total
        state["elapsed"] = min(total, sum(durations[:idx]) + position)
        state["chunkPosition"] = position
        state["chunkDuration"] = durations[idx]
    state.setdefault("chunkPosition", 0.0)
    state.setdefault("chunkDuration", state.get("duration", 0.0))
    state["speed"] = number_or(state.get("speed"), 1.0)
    state["generating"] = is_generating(state)
    state.pop("mpvIndex", None)
    state.pop("idle", None)
    print(json.dumps(state, ensure_ascii=False, separators=(",", ":")))
    sys.exit(0)

if action == "append":
    path = sys.argv[2] if len(sys.argv) > 2 else ""
    if not path or not os.path.isfile(path):
        sys.exit(2)
    reply = send(["loadfile", path, "append-play"])
    sys.exit(0 if reply.get("error") == "success" else 1)

if action == "wait-end":
    while os.path.exists(socket_path):
        idx = send(["get_property", "playlist-pos"]).get("data")
        count = send(["get_property", "playlist-count"]).get("data")
        idle = send(["get_property", "idle-active"]).get("data")
        if isinstance(count, int) and count > 0 and idx == -1 and idle is True:
            send(["quit"])
            break
        time.sleep(0.2)
    sys.exit(0)

if action == "seek":
    try:
        target = max(0.0, float(sys.argv[2]))
    except (ValueError, IndexError):
        sys.exit(2)
    seek_global(target)
    sys.exit(0)

if action == "seek-chunk":
    try:
        target = max(0.0, float(sys.argv[2]))
    except (ValueError, IndexError):
        sys.exit(2)
    seek_chunk(target)
    sys.exit(0)

if action == "skip":
    try:
        delta = float(sys.argv[2])
    except (ValueError, IndexError):
        sys.exit(2)
    state = read_state()
    if is_generating(state):
        send(["seek", delta, "relative"])
    else:
        durations = durations_from(state)
        if not durations:
            send(["seek", delta, "relative"])
        else:
            props = mpv_properties()
            idx = min(current_chunk_index(state, props), len(durations) - 1)
            position = number_or(props.get("position"), number_or(state.get("chunkPosition"), 0.0))
            seek_global(sum(durations[:idx]) + position + delta)
    sys.exit(0)

if action == "speed":
    try:
        speed = float(sys.argv[2])
    except (ValueError, IndexError):
        sys.exit(2)
    speed = min(3.0, max(0.5, speed))
    send(["set_property", "speed", speed])
    write_state(speed=speed)
    sys.exit(0)

commands = {
    "pause": ["set_property", "pause", True],
    "resume": ["set_property", "pause", False],
    "toggle": ["cycle", "pause"],
    "next": ["playlist-next"],
    "prev": ["playlist-prev"],
    "stop": ["quit"],
}
if action not in commands:
    sys.exit(2)

try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(1)
        client.connect(socket_path)
        payload = {"command": commands[action], "request_id": 1}
        client.sendall((json.dumps(payload) + "\n").encode())
        try:
            client.recv(4096)
        except socket.timeout:
            pass
except OSError as error:
    print(str(error), file=sys.stderr)
    sys.exit(1)
