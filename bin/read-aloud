#!/usr/bin/env bash
plugin_dir=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
runtime="${XDG_RUNTIME_DIR:-/tmp}/read-aloud"
pidfile="$runtime/pid"
state="$runtime/state.json"
socket="$runtime/mpv.sock"
playlist="$runtime/playlist.txt"
concat_list="$runtime/concat.txt"
final="$runtime/final.mp3"
tts_script="$plugin_dir/bin/read-aloud-tts"
tts_log="$runtime/tts.log"
tts_err="$runtime/tts-last.err"
keep_state=0

ipc() {
  qs ipc --path /usr/share/omarchy/shell call toshich20.read-aloud "$1" >/dev/null 2>&1 || true
}

if [[ -f "$pidfile" ]]; then
  pid=$(<"$pidfile")
  if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null
    ipc close
  fi
  rm -f "$pidfile"
  exit 0
fi

text=$(wl-paste -p 2>/dev/null)
[[ -z "$text" ]] && text=$(wl-paste 2>/dev/null)
[[ -z "$text" ]] && exit 0

voices=$(python3 - <<'PY'
import json
import os

ru = "v5_ru:aidar"
en = "v3_en:en_0"
speed = 1.0
path = os.path.expanduser("~/.config/omarchy/shell.json")

def walk(node):
    global ru, en, speed
    if isinstance(node, dict):
        if node.get("id") == "toshich20.read-aloud":
            ru = str(node.get("ruVoice", ru))
            en = str(node.get("enVoice", en))
            try:
                value = float(str(node.get("speed", "1x")).strip().rstrip("xX"))
                speed = value if 0.5 <= value <= 3.0 else 1.0
            except ValueError:
                pass
        for value in node.values():
            walk(value)
    elif isinstance(node, list):
        for value in node:
            walk(value)

try:
    with open(path, encoding="utf-8") as handle:
        walk(json.load(handle))
except (OSError, ValueError):
    pass

print(ru)
print(en)
print(format(speed, "g"))
PY
)
mapfile -t voice_settings <<< "$voices"
ru_voice="${voice_settings[0]:-v5_ru:aidar}"
en_voice="${voice_settings[1]:-v3_en:en_0}"
speed="${voice_settings[2]:-1}"

mkdir -p "$runtime"
rm -f "$state" "$socket" "$playlist" "$concat_list" "$final" "$runtime"/chunk-*.mp3

cleanup() {
  [[ -n "${mpv_pid:-}" ]] && kill "$mpv_pid" 2>/dev/null
  [[ -n "${tts_pid:-}" ]] && kill "$tts_pid" 2>/dev/null
  [[ -n "${watcher_pid:-}" ]] && kill "$watcher_pid" 2>/dev/null
  rm -f "$pidfile" "$socket" "$playlist" "$concat_list" "$tts_err" "$runtime"/chunk-*.mp3
  (( keep_state )) || rm -f "$state"
}
trap cleanup EXIT
trap 'trap - EXIT; cleanup; exit 0' INT TERM

write_state() {
  python3 - "$state" "$@" <<'PY'
import json
import os
import sys

path = sys.argv[1]
try:
    with open(path, encoding="utf-8") as handle:
        data = json.load(handle)
    if not isinstance(data, dict):
        data = {}
except (OSError, ValueError):
    data = {}
for arg in sys.argv[2:]:
    key, _, value = arg.partition("=")
    if key == "durations":
        data[key] = [float(item) for item in value.split(",") if item]
    elif key in {"index", "total", "failed", "prepared", "percent", "eta"}:
        data[key] = int(float(value or 0))
    elif key in {"duration", "elapsed", "chunkPosition", "chunkDuration"}:
        data[key] = float(value or 0)
    else:
        data[key] = value

tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8") as handle:
    json.dump(data, handle, ensure_ascii=False, separators=(",", ":"))
    handle.write("\n")
os.replace(tmp, path)
PY
}

write_state speed="$speed"

printf '%s\n' "$$" > "$pidfile"
ipc open

mapfile -d '' -t chunks < <(python3 "$plugin_dir/bin/split-text.py" 450 <<< "$text")
total=${#chunks[@]}
[[ "$total" -eq 0 ]] && exit 0

: > "$tts_log"
printf '%s start chunks=%d\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$total" >> "$tts_log"

: > "$playlist"
: > "$concat_list"
audio_files=()
durations=()
failed=0
index=0
prepared=0
started=$(date +%s)
tts_pid=""
mpv_pid=""
watcher_pid=""
playback_started=0

for chunk in "${chunks[@]}"; do
  index=$((index + 1))
  elapsed=$(( $(date +%s) - started ))
  if (( prepared > 0 )); then eta=$(( elapsed * (total - prepared) / prepared )); else eta=0; fi
  percent=$(( prepared * 100 / total ))
  if (( playback_started )); then
    duration_list=$(IFS=,; echo "${durations[*]}")
    total_duration=$(python3 -c 'import sys; print(sum(map(float, sys.argv[1:])) if len(sys.argv) > 1 else 0)' "${durations[@]}")
    write_state status=playing index=0 total="$total" failed="$failed" prepared="$prepared" percent="$percent" eta="$eta" durations="$duration_list" duration="$total_duration" audioPath="$final"
  else
    write_state status=synthesizing index="$index" total="$total" failed="$failed" prepared="$prepared" percent="$percent" eta="$eta"
  fi

  if printf '%s' "$chunk" | grep -q '[А-Яа-яЁё]'; then
    voice="$ru_voice"
  else
    voice="$en_voice"
  fi

  audio="$runtime/chunk-$(printf '%03d' "$index").mp3"
  ok=0
  attempt=0
  for delay in 0 1 3; do
    sleep "$delay"
    attempt=$((attempt + 1))
    if "$tts_script" --voice "$voice" --text "$chunk" --write-media "$audio" >/dev/null 2>"$tts_err" & tts_pid=$!; wait "$tts_pid"; then
      ok=1
      break
    else
      rc=$?
      {
        printf '[%s] backend=silero chunk=%d/%d voice=%s attempt=%d failed rc=%d\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$index" "$total" "$voice" "$attempt" "$rc"
        cat "$tts_err"
      } >> "$tts_log"
      rm -f "$tts_err"
    fi
  done

  if (( ok )); then
    audio_files+=("$audio")
    prepared=$((prepared + 1))
    duration=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$audio" 2>/dev/null || true)
    printf '[%s] backend=silero chunk=%d/%d voice=%s attempt=%d ok duration=%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$index" "$total" "$voice" "$attempt" "${duration:-0}" >> "$tts_log"
    durations+=("${duration:-0}")
    duration_list=$(IFS=,; echo "${durations[*]}")
    total_duration=$(python3 -c 'import sys; print(sum(map(float, sys.argv[1:])) if len(sys.argv) > 1 else 0)' "${durations[@]}")

    if (( ! playback_started )); then
      mpv --no-video --really-quiet --idle=yes --speed="$speed" --input-ipc-server="$socket" "$audio" & mpv_pid=$!
      for _ in $(seq 1 50); do
        [[ -S "$socket" ]] && "$plugin_dir/bin/read-aloud-ctl" status >/dev/null 2>&1 && break
        sleep 0.1
      done
      playback_started=1
    else
      "$plugin_dir/bin/read-aloud-ctl" append "$audio" >/dev/null 2>&1 || true
    fi

    percent=$(( prepared * 100 / total ))
    write_state status=playing index=0 total="$total" failed="$failed" prepared="$prepared" percent="$percent" eta="$eta" duration="$total_duration" durations="$duration_list" audioPath="$final"
  else
    failed=$((failed + 1))
  fi
done

tts_pid=""
if (( ${#audio_files[@]} == 0 )); then
  notify-send "Озвучка текста" "Не удалось озвучить ни одного куска" 2>/dev/null || true
  exit 1
fi

for audio in "${audio_files[@]}"; do
  printf '%s\n' "$audio" >> "$playlist"
  printf "file '%s'\n" "$audio" >> "$concat_list"
done

ffmpeg -hide_banner -loglevel error -y -f concat -safe 0 -i "$concat_list" -c copy "$final" >/dev/null 2>&1 || cat "${audio_files[@]}" > "$final"
total_duration=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$final" 2>/dev/null || true)
if [[ -z "$total_duration" || "$total_duration" == "N/A" ]]; then
  total_duration=$(python3 -c 'import sys; print(sum(map(float, sys.argv[1:])) if len(sys.argv) > 1 else 0)' "${durations[@]}")
fi
duration_list=$(IFS=,; echo "${durations[*]}")
write_state status=playing index=0 total="$total" failed="$failed" prepared="$prepared" percent=100 eta=0 duration="$total_duration" durations="$duration_list" audioPath="$final"

"$plugin_dir/bin/read-aloud-ctl" wait-end >/dev/null 2>&1 & watcher_pid=$!
wait "$mpv_pid"
kill "$watcher_pid" 2>/dev/null || true
watcher_pid=""
mpv_pid=""

if (( failed > 0 )); then
  notify-send "Озвучка текста" "Не удалось озвучить $failed из $total кусков" 2>/dev/null || true
fi

keep_state=1
write_state status=ready index="$total" total="$total" failed="$failed" prepared="$prepared" percent=100 eta=0 duration="$total_duration" elapsed="$total_duration" durations="$duration_list" audioPath="$final"
