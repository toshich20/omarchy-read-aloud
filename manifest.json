{
  "schemaVersion": 1,
  "id": "toshich20.read-aloud",
  "name": "Read Aloud",
  "version": "0.7.0",
  "author": "toshich20",
  "description": "Reads selected text aloud with local Silero TTS, split into chunks for long passages.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Read Aloud",
    "description": "Bar icon and player panel for local Silero TTS speech synthesis.",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "ruVoice": "v5_6_ru:aidar",
      "enVoice": "v3_en:en_0",
      "speed": "1x",
      "prepareText": true
    },
    "schema": [
      {
        "key": "ruVoice",
        "type": "enum",
        "label": "Russian voice",
        "options": ["v5_6_ru:aidar", "v5_6_ru:baya", "v5_6_ru:kseniya", "v5_6_ru:eugene", "v5_6_ru:xenia"],
        "defaultValue": "v5_6_ru:aidar"
      },
      {
        "key": "enVoice",
        "type": "enum",
        "label": "English voice",
        "options": ["v3_en:en_0", "v3_en:en_1", "v3_en:en_2", "v3_en:en_3", "v3_en:en_4", "v3_en:en_5", "v3_en:en_6", "v3_en:en_7", "v3_en:en_8", "v3_en:en_9", "v3_en:en_10", "v3_en:en_11"],
        "defaultValue": "v3_en:en_0"
      },
      {
        "key": "speed",
        "type": "enum",
        "label": "Playback speed",
        "options": ["1x", "1.5x", "2x"],
        "defaultValue": "1x",
        "description": "Applied to every chunk and kept between chunks."
      },
      {
        "key": "prepareText",
        "type": "boolean",
        "label": "Text preparation",
        "defaultValue": true,
        "description": "Use local Ollama to add stress marks, SSML intonation and transliteration before Russian TTS."
      }
    ]
  }
}
